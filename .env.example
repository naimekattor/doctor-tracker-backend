# Doctor Tracker — Backend Environment Variables

# Server Port
PORT=5000

# MongoDB Atlas Connection URI (Cluster0)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.z1mshhn.mongodb.net/doctor_tracker?retryWrites=true&w=majority

# JSON Web Token Secret (generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
JWT_SECRET=your_super_secret_jwt_key_at_least_32_chars

# Frontend Client Origin for CORS Whitelisting
CLIENT_URL=http://localhost:3000
# Production Frontend Origin:
# CLIENT_URL=https://doctor-tracker-rosy.vercel.app